{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",

      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",

      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm outdated)",
      "Bash(npm list:*)",
      "Bash(bundle install)",
      "Bash(bundle exec jekyll build:*)",
      "Bash(mise install)",
      "Bash(mise ls:*)",

      "Bash(npx eslint:*)",
      "Bash(npx stylelint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx markdownlint:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(npx cspell:*)",
      "Bash(npx commitlint:*)",
      "Bash(npx playwright test:*)",
      "Bash(trunk check:*)"
    ]
  }
}
