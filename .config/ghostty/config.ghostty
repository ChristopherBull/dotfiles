theme = Catppuccin Mocha

font-family = FiraCode Nerd Font

# true is the default intensity of 20 on macOS; on Linux the number value
# is ignored and any positive value or true just turns blur on
background-blur = true
background-opacity = 0.8

# Initial window dimensions (140 × 40 = comfortably larger)
window-width = 140
window-height = 40

# Breathing room around terminal content
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# Shell integration
shell-integration = detect
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

# Cursor
mouse-hide-while-typing = true
