#!/usr/bin/env bash
# Toggle the display setup between the two desk monitors (Philips + Dell)
# and the LG TV. KDE's kscreen daemon remembers each output's mode,
# position, rotation and scale per output-topology, so enable/disable is
# enough to restore the desk layout or the TV's 4K/HDR mode.
set -euo pipefail

readonly TV_OUTPUT="HDMI-A-2"   # LG TV
readonly DESK_OUTPUTS=(
    "HDMI-A-1"  # Philips
    "DP-2"      # Dell
)

# Fixed ALSA sink names for this machine's actual wiring (confirmed via
# `pactl list cards` / `wpctl status` — the GPU's HDMI audio port for the
# Philips shows up as extra2, the TV's as extra3). Targeting these directly,
# rather than pattern-matching "whichever sink looks like hdmi", matters
# because during a switch the old sink can briefly linger alongside the new
# one — a name match would sometimes grab the stale one right before it
# disappeared, silently leaving audio on the wrong device.
readonly DESK_AUDIO_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"   # Built-in Audio (desk speakers)
readonly TV_AUDIO_SINK="alsa_output.pci-0000_03_00.1.hdmi-stereo-extra3" # LG TV via GPU HDMI audio

usage() {
    echo "Usage: desk-tv-toggle [desk|tv]" >&2
    echo "  With no argument, switches to whichever mode isn't currently active." >&2
    exit 1
}

for cmd in kscreen-doctor jq pactl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "desk-tv-toggle: required command '$cmd' not found" >&2
        exit 1
    fi
done

tv_is_active() {
    kscreen-doctor -j | jq -e --arg name "$TV_OUTPUT" \
        '.outputs[] | select(.name == $name) | .enabled' >/dev/null
}

# pactl set-default-sink only affects new streams, so also move whatever is
# already playing (matches how Windows moves audio to the active display).
# The target sink can take a few seconds to appear (a real TV waking from
# HDMI standby is slow), so poll for it rather than assuming a fixed delay
# is enough.
switch_audio() {
    local mode="$1" sink attempt

    if [[ "$mode" == "tv" ]]; then
        sink="$TV_AUDIO_SINK"
    else
        sink="$DESK_AUDIO_SINK"
    fi

    for attempt in $(seq 1 20); do
        pactl list short sinks | awk '{print $2}' | grep -qxF "$sink" && break
        sleep 0.5
    done

    if ! pactl list short sinks | awk '{print $2}' | grep -qxF "$sink"; then
        echo "desk-tv-toggle: expected $mode audio sink '$sink' not found after waiting; leaving audio unchanged" >&2
        return
    fi

    pactl set-default-sink "$sink"
    pactl list short sink-inputs | while read -r id _; do
        pactl move-sink-input "$id" "$sink"
    done
}

# KWin on Wayland only schedules a new frame in response to a buffer commit or
# an input event. When the display change is triggered with no on-screen window
# driving repaints (i.e. launched from the .desktop shortcut rather than a
# terminal), the first page flip after the modeset can stall until an input
# event arrives, leaving the whole session apparently frozen. Forcing the
# compositor to reinitialise pushes fresh page flips and clears the stall. Only
# meaningful under KWin; a no-op (best effort) anywhere qdbus6 is absent.
nudge_compositor() {
    command -v qdbus6 >/dev/null 2>&1 || return 0
    qdbus6 org.kde.KWin /Compositor org.kde.kwin.Compositing.reinitialize \
        >/dev/null 2>&1 || true
}

# Why this is two kscreen-doctor calls with a sleep, not one atomic switch:
#
# The obvious form is a single kscreen-doctor invocation that disables the old
# outputs and enables the new ones together, so KWin applies it as one atomic
# DRM commit. That works fine when run from a terminal, but when the same
# command is launched from the .desktop shortcut (no on-screen window driving
# repaints) it reliably wedges the compositor: the screen freezes and only
# advances one frame per key press. The trigger is the single commit that
# removes the only currently-active output at the same moment it adds the new
# ones. KWin's "sole active output replaced in one commit" path is fragile and
# the first post-modeset page flip never completes.
#
# So instead: first commit brings the target outputs up (now there are extra
# live outputs, a safe change), then — after a short pause to let that modeset
# settle and present a frame — a second commit takes the old outputs down.
# There is always a live output across the transition, so the fragile path is
# never hit. The sleep is the settle gap between the two modesets; ~1s is
# imperceptible in this workflow and generous enough for a slow HDMI modeset.
#
# The TV's HDR mode is toggled in the same direction as its own output (off
# before the TV goes down, on as it comes up) so the 4K/HDR pipeline is never
# set up or torn down in the same commit as an output moving the other way.
to_desk() {
    kscreen-doctor \
        output."${DESK_OUTPUTS[0]}".enable \
        output."${DESK_OUTPUTS[1]}".enable
    sleep 1  # let the "desk outputs up" modeset settle before removing the TV
    kscreen-doctor \
        output."$TV_OUTPUT".hdr.disable \
        output."$TV_OUTPUT".disable
    switch_audio desk
    nudge_compositor
    echo "Switched to desk monitors (Philips + Dell)"
}

to_tv() {
    kscreen-doctor \
        output."$TV_OUTPUT".enable \
        output."$TV_OUTPUT".hdr.enable
    sleep 1  # let the "TV up" modeset settle before removing the desk outputs
    kscreen-doctor \
        output."${DESK_OUTPUTS[0]}".disable \
        output."${DESK_OUTPUTS[1]}".disable
    switch_audio tv
    nudge_compositor
    echo "Switched to LG TV"
}

target="${1:-}"
case "$target" in
    desk|tv) ;;
    "")
        if tv_is_active; then target="desk"; else target="tv"; fi
        ;;
    *) usage ;;
esac

if [[ "$target" == "tv" ]]; then
    to_tv
else
    to_desk
fi
